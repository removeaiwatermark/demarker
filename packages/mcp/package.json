{
	"name": "@demarker/mcp",
	"version": "0.1.2",
	"description": "MCP server for Demarker: identify what an AI image carries, then clean it, from Claude, Cursor and other MCP clients.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/removeaiwatermark/demarker.git",
		"directory": "packages/mcp"
	},
	"bugs": {
		"url": "https://github.com/removeaiwatermark/demarker/issues"
	},
	"mcpName": "io.demarker/mcp",
	"type": "module",
	"bin": {
		"demarker-mcp": "./dist/server.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=20"
	},
	"homepage": "https://demarker.io/developers",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"demarker",
		"ai-watermark",
		"synthid",
		"image"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/server.js',0o755)\"",
		"type-check": "tsc --noEmit",
		"test": "node --test \"src/**/*.test.ts\"",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@demarker/client": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"typescript": "5.9.3"
	}
}
